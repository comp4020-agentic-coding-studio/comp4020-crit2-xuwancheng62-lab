---
// The shared shell for every page. Astro renders each page's content into
// <slot />, so anything placed here appears identically on every page — which
// is how the "shared furniture holds still" rule in CLAUDE.md gets enforced by
// structure rather than by remembering to copy markup.
interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
  </head>
  <body>
    <nav aria-label="Primary">
      <!-- Nav links go here once you've decided what the pages are. Build each
           href from import.meta.env.BASE_URL, not as a bare "/path". -->
    </nav>
    <main>
      <slot />
    </main>
  </body>
</html>
