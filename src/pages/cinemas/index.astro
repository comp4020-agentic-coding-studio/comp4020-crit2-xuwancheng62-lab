---
import Base from "../../layouts/Base.astro";
import { cinemas } from "../../data/cinemas";
---

<Base
  title="Cinemas — HOYTS Cinemas"
  description="Find your nearest HOYTS cinema in Canberra."
>
  <h1>Cinemas</h1>
  <p class="intro">
    Two HOYTS cinemas serve Canberra and the ACT. Tap a location for
    directions, or call ahead for accessibility or group bookings.
  </p>

  <ul class="cinema-list">
    {
      cinemas.map((cinema) => (
        <li class="cinema">
          <h2>{cinema.name}</h2>
          <address>
            {cinema.address}
          </address>
          <p>
            <a href={`tel:${cinema.phone.replace(/[^+\d]/g, "")}`}>
              {cinema.phone}
            </a>
          </p>
          <p>
            <a href={cinema.mapUrl} target="_blank" rel="noreferrer">
              Get directions
            </a>
          </p>
          <ul class="amenities">
            {cinema.amenities.map((amenity) => (
              <li>{amenity}</li>
            ))}
          </ul>
        </li>
      ))
    }
  </ul>
</Base>

<style>
  .intro {
    max-width: 40em;
    color: var(--colour-text-muted);
  }

  .cinema-list {
    list-style: none;
    margin: var(--space-5) 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-4);
  }

  .cinema {
    border: 1px solid var(--colour-border);
    border-radius: var(--radius);
    padding: var(--space-4);
  }

  .cinema h2 {
    font-size: var(--text-lg);
  }

  address {
    font-style: normal;
    color: var(--colour-text-muted);
    margin-bottom: var(--space-2);
  }

  .amenities {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    padding: 0;
    margin: var(--space-3) 0 0;
  }

  .amenities li {
    border: 1px solid var(--colour-border);
    border-radius: var(--radius);
    padding: 0 var(--space-1);
    font-size: var(--text-sm);
    color: var(--colour-text-muted);
  }

  @media (max-width: 700px) {
    .cinema-list {
      grid-template-columns: 1fr;
    }
  }
</style>
