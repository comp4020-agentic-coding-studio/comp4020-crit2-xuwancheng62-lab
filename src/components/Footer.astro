---
import { href } from "../lib/url";

const here = Astro.url.pathname;
---

<footer class="site-footer">
  <p>
    An unsolicited redesign concept for HOYTS Cinemas, not affiliated with or
    endorsed by HOYTS. For real sessions, bookings and accounts, visit{" "}
    <a href="https://www.hoyts.com.au/" target="_blank" rel="noreferrer"
      >hoyts.com.au</a
    >.
  </p>
  <p><a href={href("/cinemas/", here)}>Find a cinema</a></p>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--colour-border);
    margin-top: var(--space-6);
    padding: var(--space-4);
    color: var(--colour-text-muted);
    font-size: var(--text-sm);
    max-width: 1280px;
    margin-inline: auto;
  }

  .site-footer p {
    margin: 0 0 var(--space-2);
  }
</style>
